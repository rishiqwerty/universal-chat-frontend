# Server origin only (no trailing slash). All requests use {this}/api/v1/...
VITE_API_BASE_URL=http://localhost:8000

# Polling interval for checking image generation status (in seconds)
VITE_STUDIO_POLLING_INTERVAL_SECONDS=3

# Polling interval for checking user credit balance (in seconds)
VITE_BALANCE_CHECK_INTERVAL_SECONDS=30

# Granular controls for Email Authentication:
# Set to false to disable email sign-in completely on /login
VITE_ENABLE_EMAIL_SIGNIN=true

# Set to false to disable email registration completely on /signup
VITE_ENABLE_EMAIL_SIGNUP=true

# Set to false to disable 6-digit Email OTP passcode authentication
VITE_ENABLE_EMAIL_OTP=true

# Set to false to disable Email Password authentication
VITE_ENABLE_EMAIL_PASSWORD=true

# Google Authentication Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


